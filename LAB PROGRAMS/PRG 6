#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main()
{
    char a[50];
    int flag = 1;
    int i = 1;

    printf("\nEnter an identifier: ");
    fgets(a, sizeof(a), stdin);

    /* Remove newline */
    a[strcspn(a, "\n")] = '\0';

    /* First character must be a letter */
    if (isalpha(a[0]))
    {
        while (a[i] != '\0')
        {
            if (!isalnum(a[i]))
            {
                flag = 0;
                break;
            }
            i++;
        }
    }
    else
    {
        flag = 0;
    }

    if (flag == 1)
        printf("\nValid identifier\n");
    else
        printf("\nNot a valid identifier\n");

    return 0;
}
