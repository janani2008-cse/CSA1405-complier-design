#include <stdio.h>
#include <string.h>

int main()
{
    char s[5];

    printf("\nEnter any operator: ");
    scanf("%s", s);

    switch(s[0])
    {
        case '+':
            printf("\nAddition");
            break;

        case '-':
            printf("\nSubtraction");
            break;

        case '*':
            printf("\nMultiplication");
            break;

        case '/':
            printf("\nDivision");
            break;

        default:
            printf("\nNot an operator");
    }

    return 0;
}
